// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Conversation {
  id        String    @id @default(cuid())
  sessionId String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String       // 'user' | 'assistant'
  content        String       @db.Text
  createdAt      DateTime     @default(now())
}

model LeadSent {
  id        String   @id @default(cuid())
  email     String?
  name      String?
  company   String?
  score     Int?
  tier      String?
  createdAt DateTime @default(now())
}

// ============================================
// GROWTH OS — MODELOS
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          UserRole  @default(MEMBER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  activities    Activity[]
  assignedDeals Deal[]    @relation("AssignedDeals")
  quotes        Quote[]
  emailsSent    EmailLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum UserRole {
  ADMIN
  MEMBER
  VIEWER
}

model Contact {
  id          String        @id @default(cuid())
  firstName   String
  lastName    String?
  email       String?       @unique
  phone       String?
  position    String?
  linkedinUrl String?
  avatarUrl   String?
  source      ContactSource @default(MANUAL)
  tags        String[]
  notes       String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  companyId   String?
  company     Company?      @relation(fields: [companyId], references: [id])

  deals       Deal[]
  activities  Activity[]
  quotes      Quote[]
  emailLogs   EmailLog[]
  visitorSessions VisitorSession[]

  enrichedAt      DateTime?
  enrichmentData  Json?
}

enum ContactSource {
  MANUAL
  WEBSITE_FORM
  COTIZADOR
  CHATBOT
  APOLLO
  IMPORT
  REFERRAL
}

model Company {
  id          String   @id @default(cuid())
  name        String
  domain      String?  @unique
  industry    String?
  size        String?
  country     String?
  city        String?
  website     String?
  linkedinUrl String?
  logoUrl     String?
  phone       String?
  description String?  @db.Text
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contacts    Contact[]
  deals       Deal[]

  enrichedAt      DateTime?
  enrichmentData  Json?
}

model PipelineStage {
  id          String   @id @default(cuid())
  name        String
  order       Int
  color       String?
  isDefault   Boolean  @default(false)
  isWon       Boolean  @default(false)
  isLost      Boolean  @default(false)
  createdAt   DateTime @default(now())

  deals       Deal[]
}

model Deal {
  id            String        @id @default(cuid())
  title         String
  value         Decimal?      @db.Decimal(12, 2)
  currency      String        @default("CLP")
  probability   Int?
  expectedClose DateTime?
  closedAt      DateTime?
  lostReason    String?
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  stageId       String
  stage         PipelineStage @relation(fields: [stageId], references: [id])

  contactId     String?
  contact       Contact?      @relation(fields: [contactId], references: [id])

  companyId     String?
  company       Company?      @relation(fields: [companyId], references: [id])

  assignedToId  String?
  assignedTo    User?         @relation("AssignedDeals", fields: [assignedToId], references: [id])

  quotes        Quote[]
  activities    Activity[]
}

model Quote {
  id            String      @id @default(cuid())
  quoteNumber   String      @unique
  version       Int         @default(1)
  status        QuoteStatus @default(DRAFT)
  title         String
  description   String?     @db.Text
  subtotal      Decimal     @db.Decimal(12, 2)
  taxRate       Decimal?    @db.Decimal(5, 2)
  taxAmount     Decimal?    @db.Decimal(12, 2)
  total         Decimal     @db.Decimal(12, 2)
  currency      String      @default("CLP")
  validUntil    DateTime?
  notes         String?     @db.Text
  terms         String?     @db.Text
  pdfUrl        String?
  trackingToken String?     @unique
  viewCount     Int         @default(0)
  lastViewedAt  DateTime?
  sentAt        DateTime?
  acceptedAt    DateTime?
  rejectedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  dealId        String?
  deal          Deal?       @relation(fields: [dealId], references: [id])

  contactId     String?
  contact       Contact?    @relation(fields: [contactId], references: [id])

  createdById   String?
  createdBy     User?       @relation(fields: [createdById], references: [id])

  items         QuoteItem[]
  viewLogs      QuoteViewLog[]
}

model QuoteItem {
  id          String  @id @default(cuid())
  description String
  details     String? @db.Text
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)
  order       Int

  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model QuoteViewLog {
  id         String   @id @default(cuid())
  viewedAt   DateTime @default(now())
  ipAddress  String?
  userAgent  String?
  duration   Int?

  quoteId    String
  quote      Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

model Activity {
  id          String       @id @default(cuid())
  type        ActivityType
  title       String
  description String?      @db.Text
  metadata    Json?
  createdAt   DateTime     @default(now())

  userId      String?
  user        User?        @relation(fields: [userId], references: [id])

  contactId   String?
  contact     Contact?     @relation(fields: [contactId], references: [id])

  dealId      String?
  deal        Deal?        @relation(fields: [dealId], references: [id])
}

enum ActivityType {
  NOTE
  EMAIL_SENT
  EMAIL_OPENED
  EMAIL_CLICKED
  CALL
  MEETING
  QUOTE_SENT
  QUOTE_VIEWED
  QUOTE_ACCEPTED
  QUOTE_REJECTED
  DEAL_STAGE_CHANGED
  CONTACT_CREATED
  FORM_SUBMISSION
  WEBSITE_VISIT
  CHATBOT_CONVERSATION
}

model VisitorSession {
  id            String   @id @default(cuid())
  visitorId     String
  ipAddress     String?
  userAgent     String?
  referrer      String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  utmTerm       String?
  utmContent    String?
  country       String?
  city          String?
  deviceType    String?
  startedAt     DateTime @default(now())
  lastActivityAt DateTime @default(now())

  contactId     String?
  contact       Contact? @relation(fields: [contactId], references: [id])

  pageViews     PageView[]

  resolvedCompany String?
  resolvedDomain  String?
}

model PageView {
  id          String   @id @default(cuid())
  path        String
  title       String?
  duration    Int?
  scrollDepth Int?
  viewedAt    DateTime @default(now())

  sessionId   String
  session     VisitorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model EmailLog {
  id          String        @id @default(cuid())
  to          String
  subject     String
  body        String?       @db.Text
  status      EmailStatus   @default(QUEUED)
  resendId    String?
  openedAt    DateTime?
  clickedAt   DateTime?
  bouncedAt   DateTime?
  sentAt      DateTime?
  errorMsg    String?
  createdAt   DateTime      @default(now())

  contactId   String?
  contact     Contact?      @relation(fields: [contactId], references: [id])

  sentById    String?
  sentBy      User?         @relation(fields: [sentById], references: [id])
}

enum EmailStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  FAILED
}
